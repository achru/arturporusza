---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import portret from '../assets/photos/artur-chruszcz-ruch-siad-skret.jpg';
---

<Base
  title="O mnie — Artur Chruszcz, metoda Feldenkraisa | Artur Porusza"
  description="Artur Chruszcz: trzynaście lat pracy z człowiekiem poprzez ruch, głęboko zakorzenionej w metodzie Feldenkraisa. Gdańsk i online, ponad pięciuset klientów indywidualnych, tło w inżynierii oprogramowania."
>
  <Nav />
  <main id="tresc" class="wrap omnie-strona">
    <h1>Artur Chruszcz</h1>

    <div class="omnie-uklad">
      <div class="omnie-tresc">
        <p>
          Pracuję z człowiekiem poprzez ruch od trzynastu lat — moja praca
          głęboko zakorzeniona jest w metodzie Feldenkraisa. Pracowałem
          indywidualnie z ponad pięciuset osobami, poprowadziłem ponad sto
          warsztatów i kilkanaście wyjazdów — w Gdańsku, w Polsce i online.
        </p>
        <p>
          Do ruchu trafiłem z inżynierii oprogramowania i to tło zostało ze mną
          do dziś. Nauczyłem się tam myśleć w sprzężeniach zwrotnych: rzadko
          jest jedna przyczyna, prawie nigdy jedno rozwiązanie. Mniej interesują
          mnie gotowe recepty, a bardziej systemy rezylientne, łatwo adaptujące
          się do zmian. Metoda Feldenkraisa jest dla mnie właśnie takim
          systemem — stosowanym do codziennego poruszania się i działania.
        </p>
        <p>
          W sposobie myślenia o uczeniu się inspiruję się również terapią
          akceptacji i zaangażowania (ACT) — szczególnie jej rozumieniem
          elastyczności psychologicznej. Nie prowadzę psychoterapii. Interesuje
          mnie to, jak w ruchu możemy ćwiczyć zauważanie możliwości
          i wybieranie odpowiedzi odpowiedniej do sytuacji.
        </p>

        <h2>Przygotowanie</h2>
        <ul class="szkolenia">
          <li>
            <span class="lata">2009–2013</span>
            <span>Studia na Politechnice Gdańskiej: elektronika i telekomunikacja, specjalizacja elektroniczne systemy komputerowe.</span>
          </li>
          <li>
            <span class="lata">2016–2017</span>
            <span>Dwa kursy nauczycielskie, po 200 godzin każdy, u Richarda Freemana i Mary Taylor, Boulder (Kolorado).</span>
          </li>
          <li>
            <span class="lata">2018</span>
            <span>Asysta podczas 200-godzinnego kursu nauczycielskiego u Richarda Freemana i Mary Taylor, Boulder (Kolorado).</span>
          </li>
          <li>
            <span class="lata">2019–2022</span>
            <span>Czteroletni trening metody Feldenkraisa, Malaga.</span>
          </li>
          <li>
            <span class="lata">2022–2023</span>
            <span>Ukończenie czteroletniego szkolenia metody Feldenkraisa Milano–Levico&nbsp;6 z Marą Fusero.</span>
          </li>
          <li>
            <span class="lata">2024</span>
            <span>Trzymodułowe szkolenie zaawansowane z Jeremym Kraussem (Bawaria): procesy zmiany w sesjach indywidualnych.</span>
          </li>
          <li>
            <span class="lata">2024–2025</span>
            <span>Dwuletnie szkolenie zaawansowane IOPS z Jeffem Hallerem, Seattle.</span>
          </li>
          <li>
            <span class="lata">2020</span>
            <span>Dodatkowo: ACT Immersion (online) u Stevena Hayesa.</span>
          </li>
        </ul>

        <p>
          Najszybciej znajdziesz mnie na
          <a href="/#terminy">aktualnych zajęciach</a> albo na
          <a href="/#sesje">sesji indywidualnej</a>.
        </p>
      </div>

      <figure class="omnie-foto">
        <Image
          src={portret}
          alt="Artur Chruszcz w ruchu: siad na podłodze ze skrętem tułowia i ręką prowadzoną po łuku"
          width={760}
          widths={[360, 560, 760]}
          sizes="(max-width: 860px) 92vw, 34vw"
          loading="lazy"
        />
      </figure>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .omnie-strona {
    padding-block: clamp(2.5rem, 6vw, 4rem) clamp(4rem, 8vw, 6.5rem);
  }

  .omnie-strona h1 {
    margin-bottom: 2rem;
  }

  .omnie-uklad {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .omnie-tresc p {
    color: var(--ink-soft);
    max-width: 42em;
  }

  .omnie-tresc p + p,
  .omnie-tresc h2 + p {
    margin-top: 1.1rem;
  }

  .omnie-tresc h2 {
    margin-top: 2.2rem;
  }

  .omnie-tresc a {
    color: var(--akcent);
  }

  /* Lista szkoleń: rok jako kotwica skanowania, jak daty w Terminach. */
  .szkolenia {
    list-style: none;
    margin-top: 1.1rem;
    max-width: 42em;
  }

  .szkolenia li {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 0.2rem 1.4rem;
    padding-block: 0.75rem;
    border-top: 1px solid var(--linia);
  }

  .szkolenia li:first-child {
    border-top: none;
    padding-top: 0.2rem;
  }

  .szkolenia .lata {
    font-weight: 500;
    font-size: 0.95rem;
    font-variant-numeric: oldstyle-nums;
  }

  .szkolenia li > span:last-child {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  @media (max-width: 560px) {
    .szkolenia li {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }

  .omnie-foto {
    border-radius: var(--radius);
    border: 1px solid var(--linia);
    overflow: hidden;
  }

  .omnie-foto :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(1) contrast(1.04);
  }

  @media (max-width: 860px) {
    .omnie-uklad {
      grid-template-columns: 1fr;
    }

    .omnie-foto {
      order: -1;
      max-width: 22rem;
    }
  }
</style>
