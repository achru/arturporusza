---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Oferta from '../components/Oferta.astro';
import Droga from '../components/Droga.astro';
import Zmiany from '../components/Zmiany.astro';
import Praktyka from '../components/Praktyka.astro';
import SocialProof from '../components/SocialProof.astro';
import Kalendarz from '../components/Kalendarz.astro';
import Sesje from '../components/Sesje.astro';
import OMnie from '../components/OMnie.astro';
import NewsletterPanel from '../components/NewsletterPanel.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Nav />
  <main id="tresc">
    <Hero />
    <Oferta />
    <Droga />
    <Zmiany />
    <Praktyka />
    <SocialProof />
    <Kalendarz />
    <Sesje />
    <OMnie />
    <NewsletterPanel />
  </main>
  <Footer />
</Base>
