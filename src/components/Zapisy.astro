---
import Winietka from './Winietka.astro';
import { wyroznione, NAZWY_TYPOW, KOLORY_TYPOW, klasaStatusu, linkWydarzenia } from '../lib/wydarzenia';
---

{
  wyroznione.length > 0 && (
    <section id="zapisy" class="sekcja-krecha" aria-label="Aktualne zapisy">
      <div class="wrap">
        <p class="kicker" data-reveal>
          Aktualnie
        </p>
        <h2 data-reveal>
          Zapisy <em>trwają</em>
        </h2>
        <div class="wyroznione-siatka">
          {wyroznione.map((w) => (
            <article class="karta" data-reveal data-data={w.data}>
              <div class="karta-art">
                <Winietka typ={w.typ} />
              </div>
              <div class="karta-tresc">
                <div class="karta-meta">
                  <span class="typ" style={`--kolor-typu:${KOLORY_TYPOW[w.typ]}`}>
                    {NAZWY_TYPOW[w.typ]}
                  </span>
                  <span>{w.dataTekst}</span>
                  <span>·</span>
                  <span>{w.miejsce}</span>
                </div>
                <h3>{w.tytul}</h3>
                {w.podtytul && <p class="podtytul">{w.podtytul}</p>}
                <p class="opis">{w.opis}</p>
                <div class="karta-stopka">
                  <span class={`chip ${klasaStatusu(w.status)}`}>{w.status}</span>
                  <a class="link-strzalka" href={linkWydarzenia(w)}>
                    Szczegóły i zapisy <span class="strzalka">→</span>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .wyroznione-siatka {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(400px, 100%), 1fr));
    gap: 1.4rem;
    margin-top: 2.4rem;
  }

  .karta {
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid var(--linia);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: background 0.3s ease;
  }

  .karta:hover {
    background: rgba(255, 255, 255, 0.85);
  }

  .karta-art {
    padding: 1.2rem 1.5rem 0;
  }

  .karta-tresc {
    padding: 1rem 1.6rem 1.7rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    flex: 1;
  }

  .karta-meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
    font-size: 0.82rem;
    color: var(--ink-soft);
  }

  .karta h3 {
    margin-top: 0.1rem;
  }

  .karta .podtytul {
    font-family: var(--f-display);
    font-style: italic;
    color: var(--ink-soft);
    font-size: 1.05rem;
    margin-top: -0.45rem;
  }

  .karta .opis {
    color: var(--ink-soft);
    font-size: 0.96rem;
  }

  .karta-stopka {
    margin-top: auto;
    padding-top: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
