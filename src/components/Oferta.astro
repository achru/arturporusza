---
import Winietka from './Winietka.astro';
import { wyroznione, NAZWY_TYPOW, KOLORY_TYPOW, klasaStatusu, linkWydarzenia } from '../lib/wydarzenia';

const [glowna, druga] = wyroznione;
---

{
  glowna && (
    <section id="zajecia" class="sekcja-krecha" aria-label="Aktualne zapisy">
      <div class="wrap">
        <p class="kicker" data-reveal>
          Aktualnie
        </p>
        <h2 data-reveal>
          Zapisy <em>trwają</em>
        </h2>

        <div class="oferta-siatka" data-reveal>
          <a
            class="karta karta-glowna"
            href={linkWydarzenia(glowna)}
            data-track="cta-oferta-glowna"
            aria-label={`${glowna.tytul} — szczegóły i zapisy`}
          >
            <div class="karta-art">
              <Winietka typ={glowna.typ} />
            </div>
            <div class="karta-tresc">
              <div class="karta-meta">
                <span class="typ" style={`--kolor-typu:${KOLORY_TYPOW[glowna.typ]}`}>
                  {NAZWY_TYPOW[glowna.typ]}
                </span>
                <span>{glowna.dataTekst}</span>
                <span>·</span>
                <span>{glowna.miejsce}</span>
              </div>
              <h3>{glowna.tytul}</h3>
              {glowna.podtytul && <p class="podtytul">{glowna.podtytul}</p>}
              <p class="obietnica">{glowna.obietnica}</p>
              <div class="karta-stopka">
                <span class={`chip ${klasaStatusu(glowna.status)}`}>{glowna.status}</span>
                <span class="btn-cta karta-cta">
                  Szczegóły i zapisy <span class="strzalka">→</span>
                </span>
              </div>
            </div>
          </a>

          {druga && (
            <a
              class="karta karta-druga"
              href={linkWydarzenia(druga)}
              data-track="cta-oferta-druga"
              aria-label={`${druga.tytul} — szczegóły i zapisy`}
            >
              <div class="karta-tresc">
                <div class="karta-meta">
                  <span class="typ" style={`--kolor-typu:${KOLORY_TYPOW[druga.typ]}`}>
                    {NAZWY_TYPOW[druga.typ]}
                  </span>
                  <span>{druga.dataTekst}</span>
                  <span>·</span>
                  <span>{druga.miejsce}</span>
                </div>
                <h3>{druga.tytul}</h3>
                <p class="obietnica">{druga.obietnica}</p>
                <div class="karta-stopka">
                  <span class={`chip ${klasaStatusu(druga.status)}`}>{druga.status}</span>
                  <span class="link-strzalka">
                    Szczegóły <span class="strzalka">→</span>
                  </span>
                </div>
              </div>
            </a>
          )}
        </div>
      </div>
    </section>
  )
}

<style>
  .oferta-siatka {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 1.4rem;
    margin-top: 2.4rem;
    align-items: stretch;
  }

  .karta {
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid var(--linia);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: background 0.3s ease, border-color 0.3s ease, translate 0.3s ease;
  }

  .karta:hover {
    background: rgba(255, 255, 255, 0.85);
    border-color: rgba(35, 34, 29, 0.3);
    translate: 0 -3px;
  }

  .karta-glowna {
    border-width: 1px;
    box-shadow: 0 14px 34px -22px rgba(35, 34, 29, 0.4);
  }

  .karta-art {
    padding: 1.2rem 1.5rem 0;
  }

  .karta-tresc {
    padding: 1rem 1.6rem 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    flex: 1;
  }

  .karta-druga .karta-tresc {
    padding-top: 1.6rem;
  }

  .karta-meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
    font-size: 0.82rem;
    color: var(--ink-soft);
  }

  .karta h3 {
    margin-top: 0.1rem;
  }

  .karta-glowna h3 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }

  .podtytul {
    font-family: var(--f-display);
    font-style: italic;
    color: var(--ink-soft);
    font-size: 1.05rem;
    margin-top: -0.45rem;
  }

  .obietnica {
    color: var(--ink-soft);
    font-size: 0.97rem;
  }

  .karta-stopka {
    margin-top: auto;
    padding-top: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .karta-cta {
    pointer-events: none; /* klika się cała karta */
  }

  @media (max-width: 860px) {
    .oferta-siatka {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .karta {
      transition: none;
    }
  }
</style>
