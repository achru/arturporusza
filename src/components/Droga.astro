---
import { NAUCZYCIELE_URL } from '../config';

const drogi = [
  {
    tytul: 'Chcę poczuć różnicę w ruchu',
    opis: 'Warsztaty i regularne zajęcia, podczas których możesz spokojnie sprawdzić nowe możliwości poruszania się — bez forsowania i poprawiania siebie.',
    cta: 'Zobacz warsztaty i cykle',
    href: '#kalendarz',
    track: 'cta-droga-zajecia',
    kolor: 'var(--akcent)',
    motyw: 'M 6 34 C 30 18, 54 46, 78 30 C 96 18, 112 26, 122 22',
  },
  {
    tytul: 'Chcę pracować indywidualnie',
    opis: 'Praca wokół konkretnego pytania: ruchu, który stał się trudny, przewlekłego wysiłku albo sposobu działania, który przestał pomagać.',
    cta: 'Dowiedz się więcej o sesjach',
    href: '#sesje',
    track: 'cta-droga-sesje',
    kolor: 'var(--blekit)',
    motyw: 'M 6 32 C 36 30, 48 12, 66 22 C 84 32, 78 48, 96 40 C 108 34, 116 30, 122 28',
  },
  {
    tytul: 'Uczę innych',
    opis: 'Programy dla nauczycieli ruchu, trenerów i osób pracujących z ludźmi: jak projektować lekcje, które rozwijają uczenie się, a nie tylko odtwarzanie instrukcji.',
    cta: 'Zobacz ofertę dla nauczycieli',
    href: NAUCZYCIELE_URL,
    track: 'cta-droga-nauczyciele',
    zewnetrzny: true,
    kolor: 'var(--lawenda)',
    motyw: 'M 6 40 C 30 34, 44 30, 62 28 M 62 28 C 82 20, 100 14, 122 10 M 62 28 C 82 34, 100 40, 122 46',
  },
];
---

<section id="droga" class="sekcja-krecha" aria-label="Znajdź swoją drogę">
  <div class="wrap">
    <p class="kicker" data-reveal>Od czego zacząć</p>
    <h2 data-reveal>Znajdź swoją <em>drogę</em></h2>

    <div class="drogi" role="list">
      {
        drogi.map((d, i) => (
          <a
            class="droga"
            role="listitem"
            href={d.href}
            target={d.zewnetrzny ? '_blank' : undefined}
            rel={d.zewnetrzny ? 'noopener' : undefined}
            data-track={d.track}
            data-reveal
            style={`--reveal-delay:${i * 90}ms; --kolor-drogi:${d.kolor}`}
          >
            <svg class="droga-motyw" viewBox="0 0 128 56" aria-hidden="true">
              <path d={d.motyw} />
            </svg>
            <h3>{d.tytul}</h3>
            <p>{d.opis}</p>
            <span class="link-strzalka">
              {d.cta} <span class="strzalka">→</span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .drogi {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.4rem;
    margin-top: 2.4rem;
  }

  .droga {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.6rem 1.6rem 1.7rem;
    background: rgba(255, 255, 255, 0.45);
    border: 1px solid var(--linia);
    border-top: 3px solid var(--kolor-drogi);
    border-radius: var(--radius);
    text-decoration: none;
    color: inherit;
    transition: background 0.3s ease, translate 0.3s ease;
  }

  .droga:hover {
    background: rgba(255, 255, 255, 0.8);
    translate: 0 -3px;
  }

  .droga-motyw {
    width: 96px;
    height: 42px;
  }

  .droga-motyw path {
    fill: none;
    stroke: var(--kolor-drogi);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .droga p {
    color: var(--ink-soft);
    font-size: 0.96rem;
    flex: 1;
  }

  .droga .link-strzalka {
    align-self: flex-start;
  }

  @media (max-width: 860px) {
    .drogi {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .droga {
      transition: none;
    }
  }
</style>
