---
import { Image } from 'astro:assets';
import foto1 from '../assets/photos/zajecia-feldenkrais-praca-na-podlodze.jpg';
import foto2 from '../assets/photos/warsztat-ruchowy-feldenkrais-gdansk.jpg';
import foto3 from '../assets/photos/lekcja-feldenkrais-swiadomosc-przez-ruch.jpg';

const liczby = [
  { liczba: '13', opis: 'lat uczenia metodą Feldenkraisa' },
  { liczba: '500+', opis: 'klientów indywidualnych' },
  { liczba: '100+', opis: 'poprowadzonych warsztatów' },
  { liczba: 'kilkanaście', opis: 'wyjazdów ruchowych' },
];

/* TODO: podmień na prawdziwe opinie (za zgodą autorów). Konkretne
   i obserwacyjne, nie patetyczne. Placeholdery są widoczne na stronie
   celowo — żeby nie zapomnieć przed startem produkcyjnym. */
const opinie = [
  { tekst: '[OPINIA UCZESTNIKA]', podpis: '[IMIĘ / ROLA — za zgodą]' },
  { tekst: '[OPINIA UCZESTNIKA]', podpis: '[IMIĘ / ROLA — za zgodą]' },
  { tekst: '[OPINIA OSOBY UCZĄCEJ RUCHU]', podpis: '[IMIĘ / ROLA — za zgodą]' },
];
---

<section class="sekcja-krecha" aria-label="Doświadczenie i opinie">
  <div class="wrap">
    <p class="kicker" data-reveal>Doświadczenie</p>
    <h2 data-reveal>Ta praktyka ma już swoją <em>historię</em></h2>

    <dl class="liczby" data-reveal>
      {
        liczby.map((l) => (
          <div class="liczba">
            <dt class="sr-only">{l.opis}</dt>
            <dd>
              <strong>{l.liczba}</strong>
              <span>{l.opis}</span>
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="opinie">
      {
        opinie.map((o, i) => (
          <blockquote class="opinia" data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <p>{o.tekst}</p>
            <footer>{o.podpis}</footer>
          </blockquote>
        ))
      }
    </div>

    <div class="foto-pas" data-reveal>
      <figure>
        <Image
          src={foto1}
          alt="Uczestnik zajęć Feldenkraisa w niskim podporze na macie na podłodze"
          width={700}
          widths={[320, 520, 700]}
          sizes="(max-width: 860px) 92vw, 30vw"
          loading="lazy"
        />
      </figure>
      <figure>
        <Image
          src={foto2}
          alt="Moment warsztatu ruchowego: praca w wykroku w jasnej sali"
          width={700}
          widths={[320, 520, 700]}
          sizes="(max-width: 860px) 92vw, 30vw"
          loading="lazy"
        />
      </figure>
      <figure>
        <Image
          src={foto3}
          alt="Lekcja świadomości przez ruch — praca na podłodze"
          width={700}
          widths={[320, 520, 700]}
          sizes="(max-width: 860px) 92vw, 30vw"
          loading="lazy"
        />
      </figure>
    </div>
  </div>
</section>

<style>
  .liczby {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.4rem;
    margin-block: 2.4rem 2.6rem;
  }

  .liczba dd {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    border-top: 1px solid var(--linia);
    padding-top: 0.9rem;
  }

  .liczba strong {
    font-family: var(--f-display);
    font-weight: 500;
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    line-height: 1.1;
  }

  .liczba span {
    color: var(--ink-soft);
    font-size: 0.88rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .opinie {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.4rem;
  }

  .opinia {
    background: rgba(255, 255, 255, 0.45);
    border: 1px solid var(--linia);
    border-radius: var(--radius);
    padding: 1.5rem 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .opinia p {
    color: var(--ink-soft);
    font-size: 0.96rem;
    flex: 1;
  }

  .opinia footer {
    font-size: 0.85rem;
    color: var(--akcent);
  }

  .foto-pas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.4rem;
    margin-top: 2.6rem;
  }

  .foto-pas figure {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    border: 1px solid var(--linia);
    overflow: hidden;
  }

  .foto-pas :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 860px) {
    .liczby,
    .opinie,
    .foto-pas {
      grid-template-columns: 1fr 1fr;
    }

    .opinie {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .liczby,
    .foto-pas {
      grid-template-columns: 1fr;
    }
  }
</style>
