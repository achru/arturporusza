---
import { Image } from 'astro:assets';
import fotoLekcja from '../assets/photos/lekcja-grupowa-feldenkrais-warsztat.jpg';

const kroki = [
  {
    tytul: 'Zaczynamy od prostego ruchu lub pytania.',
    opis: 'Na przykład: jak sięgasz, jak się obracasz, jak wstajesz. Nic, do czego trzeba się przygotowywać.',
  },
  {
    tytul: 'Zmieniamy warunki.',
    opis: 'Tempo, kierunek, organizację ruchu albo sposób kierowania uwagi. Ten sam ruch przestaje być oczywisty.',
  },
  {
    tytul: 'Porównujesz możliwości.',
    opis: 'Zauważasz, co daje większą swobodę lub klarowność. To Ty robisz robotę — zauważając, poszerzasz pole swojej percepcji i repertuar możliwości.',
  },
];

const zmiany = [
  'łatwiejsze chodzenie, obracanie się i wstawanie,',
  'szybsze zauważanie, że używasz więcej wysiłku, niż potrzebujesz,',
  'większa zdolność znalezienia innego rozwiązania, kiedy pierwszy sposób nie działa.',
];
---

<section id="praktyka" class="sekcja-krecha" aria-label="Jak wygląda praktyka">
  <div class="wrap">
    <h2>Jak wygląda praktyka</h2>

    <ol class="kroki">
      {
        kroki.map((k) => (
          <li>
            <strong>{k.tytul}</strong> {k.opis}
          </li>
        ))
      }
    </ol>

    <figure class="foto">
      <Image
        src={fotoLekcja}
        alt="Lekcja grupowa Feldenkraisa w jasnej sali: Artur siedzi z boku i mówi, uczestnicy leżą na matach z ugiętymi kolanami"
        width={1200}
        widths={[480, 760, 1200]}
        sizes="(max-width: 44rem) 92vw, 40rem"
        loading="lazy"
      />
    </figure>

    <p class="wazne">Nie musisz być sprawny, rozciągnięty ani mieć doświadczenia w ruchu.</p>
    <p class="info">
      Większość zajęć grupowych odbywa się w spokojnym tempie, często na
      podłodze, w wygodnym ubraniu. To lekcje uczenia się, nie trening —
      i&nbsp;nie gimnastyka korekcyjna, fizjoterapia ani psychoterapia.
    </p>

    <h3>Co może się zmienić</h3>
    <p class="info">Nie chodzi o idealny ruch — chodzi o więcej możliwości. Na przykład:</p>
    <ul class="zmiany">
      {zmiany.map((z) => <li>{z}</li>)}
    </ul>
    <p class="info">
      Zmiana nie zawsze wygląda spektakularnie. Czasem jest nią możliwość
      obrócenia głowy bez przygotowywania całego ciała. Czasem moment,
      w&nbsp;którym zauważasz, że nie musisz ciągle trzymać brzucha, barków
      albo oddechu.
    </p>

    <h3>Feldenkrais i ACT</h3>
    <p class="info">
      W sposobie myślenia o uczeniu się inspiruję się również terapią
      akceptacji i zaangażowania — szczególnie jej rozumieniem elastyczności
      psychologicznej. Nie prowadzę psychoterapii. Interesuje mnie to, jak
      w&nbsp;ruchu możemy ćwiczyć zauważanie możliwości i wybieranie
      odpowiedzi odpowiedniej do sytuacji.
    </p>
  </div>
</section>

<style>
  .kroki {
    list-style: none;
    counter-reset: krok;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    max-width: 62ch;
  }

  .kroki li {
    counter-increment: krok;
    padding-left: 2rem;
    position: relative;
  }

  .kroki li::before {
    content: counter(krok) '.';
    position: absolute;
    left: 0;
    font-style: italic;
    color: var(--ink-soft);
    font-variant-numeric: oldstyle-nums;
  }

  .kroki strong {
    font-weight: 600;
  }

  .foto {
    margin-top: 2.2rem;
  }

  .foto :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    filter: grayscale(1) contrast(1.04);
    border-radius: var(--radius);
  }

  .wazne {
    font-style: italic;
    margin-top: 2rem;
    max-width: 62ch;
  }

  .info {
    color: var(--ink-soft);
    margin-top: 0.7rem;
    max-width: 62ch;
  }

  h3 {
    margin-top: 2.2rem;
  }

  .zmiany {
    list-style: none;
    margin-top: 0.7rem;
    max-width: 62ch;
    color: var(--ink-soft);
  }

  .zmiany li {
    padding-left: 1.4rem;
    position: relative;
  }

  .zmiany li::before {
    content: '—';
    position: absolute;
    left: 0;
  }
</style>
