---
/* Statyczna, cicha nawigacja — tekstowe linki, bez przycisków,
   bez pozycji fixed (i bez backdrop-filter — patrz PRODUCT.md). */
import Znak from './Znak.astro';
---

<header class="nav">
  <div class="wrap nav-wrap">
    <a class="logo cichy-link" href="/" aria-label="Artur Porusza — strona główna">
      <span>Artur</span>
      <Znak />
      <span>Porusza</span>
    </a>
    <nav class="nav-linki" aria-label="Główna nawigacja">
      <a class="cichy-link" href="/#terminy">Terminy</a>
      <a class="cichy-link" href="/#praktyka">Praktyka</a>
      <a class="cichy-link" href="/#sesje">Sesje</a>
      <a class="cichy-link" href="/o-mnie/">O mnie</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    padding-block: 1.4rem 0;
  }

  .nav-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    flex-wrap: wrap;
  }

  /* Logotyp z oryginalnego znaku Artura: ARTUR ⟨mózg⟩ PORUSZA.
     Krój groteskowy jest częścią marki (wyjątek od zasady jednej
     rodziny — patrz DESIGN.md), reszta strony zostaje przy Literacie. */
  .logo {
    display: flex;
    align-items: center;
    gap: 0.55em;
    font-family: 'Helvetica Neue', 'Helvetica', 'Arial', sans-serif;
    font-weight: 500;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .nav-linki {
    display: flex;
    gap: 1.4rem;
    flex-wrap: wrap;
  }

  .nav-linki a {
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .nav-linki a:hover {
    color: var(--akcent);
  }
</style>
