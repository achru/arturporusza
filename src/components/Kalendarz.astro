---
import { aktualne, NAZWY_TYPOW, KOLORY_TYPOW, klasaStatusu, linkWydarzenia } from '../lib/wydarzenia';

const eventsLd = aktualne
  .filter((w) => w.data)
  .map((w) => ({
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: w.tytul,
    startDate: w.data,
    location: { '@type': 'Place', name: w.miejsce },
    organizer: { '@type': 'Person', name: 'Artur Chruszcz' },
    ...(w.link ? { url: w.link } : {}),
  }));
---

<section id="kalendarz" class="sekcja-krecha" aria-label="Kalendarz wydarzeń">
  <div class="wrap">
    <p class="kicker" data-reveal>Kalendarz</p>
    <h2 data-reveal>Warsztaty, cykle i <em>wyjazdy</em></h2>

    <div class="filtry" role="group" aria-label="Filtruj wydarzenia" data-reveal>
      <button class="filtr aktywny" data-typ="wszystko" aria-pressed="true">Wszystko</button>
      <button class="filtr" data-typ="warsztat" aria-pressed="false">Warsztaty</button>
      <button class="filtr" data-typ="cykl" aria-pressed="false">Cykle</button>
      <button class="filtr" data-typ="wyjazd" aria-pressed="false">Wyjazdy</button>
    </div>

    <div class="lista" id="listaWydarzen" data-reveal>
      {
        aktualne.map((w) => (
          <a class="wiersz" href={linkWydarzenia(w)} data-typ={w.typ} data-data={w.data}>
            <div class="data">
              {w.dataTekst}
              <br />
              <span class="typ" style={`--kolor-typu:${KOLORY_TYPOW[w.typ]}`}>
                {NAZWY_TYPOW[w.typ]}
              </span>
            </div>
            <div>
              <h3>{w.tytul}</h3>
              <p class="opis">{w.opis}</p>
              <p class="miejsce">{w.miejsce}</p>
            </div>
            <span class={`chip ${klasaStatusu(w.status)}`}>{w.status}</span>
            <span class="strzalka" aria-hidden="true">
              →
            </span>
          </a>
        ))
      }
      <div class="pusto" hidden>
        Nowe terminy wkrótce. <a href="#newsletter">Zapisz się na newsletter</a> — informuję najpierw tam.
      </div>
    </div>
  </div>
</section>

{eventsLd.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(eventsLd)} />}

<script>
  // Filtry + chowanie wpisów, których data minęła od czasu builda.
  const lista = document.getElementById('listaWydarzen')!;
  const wiersze = [...lista.querySelectorAll<HTMLAnchorElement>('.wiersz')];
  const filtry = document.querySelectorAll<HTMLButtonElement>('.filtr');
  const pusto = lista.querySelector<HTMLElement>('.pusto')!;
  const dzis = new Date();

  wiersze.forEach((w) => {
    const d = w.dataset.data;
    if (d && new Date(`${d}T23:59:59`) < dzis) w.hidden = true;
  });
  document.querySelectorAll<HTMLElement>('[data-data]').forEach((el) => {
    const d = el.dataset.data;
    if (d && new Date(`${d}T23:59:59`) < dzis) el.hidden = true;
  });

  const zostale = wiersze.filter((w) => !w.hidden);

  function pokazTyp(typ: string) {
    let widoczne = 0;
    zostale.forEach((w) => {
      const pasuje = typ === 'wszystko' || w.dataset.typ === typ;
      w.hidden = !pasuje;
      if (pasuje) widoczne++;
    });
    pusto.hidden = widoczne > 0;
  }

  filtry.forEach((b) => {
    const typ = b.dataset.typ!;
    const n = typ === 'wszystko' ? zostale.length : zostale.filter((w) => w.dataset.typ === typ).length;
    const licznik = document.createElement('span');
    licznik.className = 'ile';
    licznik.textContent = String(n);
    b.appendChild(licznik);

    b.addEventListener('click', () => {
      filtry.forEach((x) => {
        x.classList.remove('aktywny');
        x.setAttribute('aria-pressed', 'false');
      });
      b.classList.add('aktywny');
      b.setAttribute('aria-pressed', 'true');
      pokazTyp(typ);
    });
  });

  pokazTyp('wszystko');
</script>

<style>
  .filtry {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin: 2.2rem 0 0.4rem;
  }

  .filtr {
    font: 400 14px var(--f-tekst);
    color: var(--ink-soft);
    background: transparent;
    border: 1px solid var(--linia);
    border-radius: 999px;
    padding: 0.5em 1.1em;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filtr:hover {
    border-color: var(--ink-soft);
    color: var(--ink);
  }

  .filtr.aktywny {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .filtr :global(.ile) {
    opacity: 0.55;
    margin-left: 0.35em;
  }

  .lista {
    border-top: 1px solid var(--linia);
    margin-top: 1.1rem;
  }

  .wiersz {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr) auto auto;
    gap: 1.4rem;
    align-items: center;
    padding: 1.6rem 0.3rem;
    border-bottom: 1px solid var(--linia);
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .wiersz:hover {
    background: rgba(255, 255, 255, 0.5);
  }

  .wiersz .data {
    font-size: 0.88rem;
    color: var(--ink-soft);
  }

  .wiersz .data .typ {
    margin-top: 0.55rem;
  }

  .wiersz h3 {
    font-size: 1.3rem;
  }

  .wiersz .opis {
    color: var(--ink-soft);
    font-size: 0.94rem;
    margin-top: 0.3rem;
    max-width: 44em;
  }

  .wiersz .miejsce {
    font-size: 0.84rem;
    color: var(--ink-soft);
    margin-top: 0.35rem;
  }

  .wiersz .strzalka {
    font-size: 1.25rem;
    transition: transform 0.25s ease;
    color: var(--m2);
  }

  .wiersz:hover .strzalka {
    transform: translateX(5px);
  }

  @media (max-width: 760px) {
    .wiersz {
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto;
      padding: 1.35rem 0.1rem;
      gap: 0.6rem 1rem;
    }

    .wiersz .data {
      grid-column: 1 / -1;
      display: flex;
      align-items: center;
      gap: 0.9rem;
    }

    .wiersz .data .typ {
      margin-top: 0;
    }
  }

  .pusto {
    border: 1px dashed var(--linia);
    border-radius: 16px;
    padding: 2.4rem;
    text-align: center;
    color: var(--ink-soft);
    margin-top: 1.1rem;
  }

  .pusto a {
    color: var(--m1);
  }
</style>
