---
import { CONTACT, SESJE } from '../config';

const sesjeHref =
  CONTACT.sesjeLink ||
  `mailto:${CONTACT.email}?subject=${encodeURIComponent('Sesja indywidualna')}`;

const formaty = [
  {
    tytul: 'Sesje w Gdańsku',
    opis: 'Indywidualna lekcja Feldenkraisa prowadzona przez ruch, uwagę i delikatny dotyk. Pracujemy w ubraniu, zwykle na specjalnym stole, bez forsowania i narzucania jednej poprawnej formy.',
    dlaKogo: 'Dobry wybór, jeśli wolisz uczyć się przez dotyk i mieć przestrzeń przygotowaną do pracy.',
    miejsce: 'Gdańsk',
    cena: SESJE.cenaGdansk,
    track: 'cta-sesja-gdansk',
  },
  {
    tytul: 'Sesje online',
    opis: 'Indywidualna lekcja ruchowa prowadzona słowami. Pracujemy wokół konkretnego pytania, a ruch wykonujesz we własnej przestrzeni i tempie.',
    dlaKogo: 'Dobry wybór, jeśli jesteś poza Trójmiastem albo chcesz pracować u siebie.',
    miejsce: 'online',
    cena: SESJE.cenaOnline,
    track: 'cta-sesja-online',
  },
];
---

<section id="sesje" class="pas" aria-label="Sesje indywidualne">
  <div class="wrap">
    <p class="kicker" data-reveal>Praca indywidualna</p>
    <h2 data-reveal>Sesje <em>indywidualne</em></h2>
    <p class="lead sesje-lead" data-reveal>
      Praca wokół pytania, które przynosisz: ruchu, który stał się trudny,
      przewlekłego wysiłku albo sposobu działania, który przestał pomagać.
      Pierwsze spotkanie kończy się konkretem: co dalej i po czym poznasz zmianę.
    </p>

    <div class="formaty">
      {
        formaty.map((f, i) => (
          <article class="format" data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <h3>{f.tytul}</h3>
            <p class="format-opis">{f.opis}</p>
            <p class="format-dla">{f.dlaKogo}</p>
            <dl class="format-info">
              <div class="rzad">
                <dt>Gdzie</dt>
                <dd>{f.miejsce}</dd>
              </div>
              <div class="rzad">
                <dt>Czas</dt>
                <dd>{SESJE.czas}</dd>
              </div>
              {f.cena && (
                <div class="rzad">
                  <dt>Cena</dt>
                  <dd>{f.cena}</dd>
                </div>
              )}
              {!f.cena && SESJE.cennikUrl && (
                <div class="rzad">
                  <dt>Cena</dt>
                  <dd>
                    <a href={SESJE.cennikUrl}>zobacz cennik</a>
                  </dd>
                </div>
              )}
            </dl>
            <a class="btn-cta" href={sesjeHref} data-track={f.track}>
              Umów sesję <span class="strzalka">→</span>
            </a>
          </article>
        ))
      }
    </div>

    <p class="sesje-nota" data-reveal>
      Napisz, z czym przychodzisz. Odpowiadam zwykle w ciągu 1–2 dni roboczych.
      Więcej o tym, jak wygląda praca indywidualna:
      <a href="/indywidualnie/">Integracja Funkcjonalna</a>.
    </p>
  </div>
</section>

<style>
  .pas {
    background: var(--paper-deep);
    border-block: 1px solid var(--linia);
  }

  .sesje-lead {
    margin-top: 0.3rem;
  }

  .formaty {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.4rem;
    margin-top: 2.4rem;
  }

  .format {
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid var(--linia);
    border-radius: var(--radius);
    padding: 1.7rem 1.7rem 1.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.95rem;
  }

  .format-opis {
    color: var(--ink-soft);
    font-size: 0.97rem;
  }

  .format-dla {
    font-size: 0.9rem;
    color: var(--akcent);
  }

  .format-info {
    margin-top: 0.2rem;
  }

  .format-info .rzad {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--linia);
    font-size: 0.94rem;
  }

  .format-info dt {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    align-self: center;
  }

  .format-info a {
    color: var(--akcent);
  }

  .format .btn-cta {
    margin-top: auto;
    align-self: flex-start;
  }

  .sesje-nota {
    margin-top: 1.6rem;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .sesje-nota a {
    color: var(--akcent);
  }

  @media (max-width: 860px) {
    .formaty {
      grid-template-columns: 1fr;
    }
  }
</style>
