---
import { Image } from 'astro:assets';
import { CONTACT, SESJE } from '../config';
import fotoSesja from '../assets/photos/integracja-funkcjonalna-sesja-indywidualna-gdansk.jpg';

const sesjeHref =
  CONTACT.sesjeLink ||
  `mailto:${CONTACT.email}?subject=${encodeURIComponent('Sesja indywidualna')}`;

const formaty = [
  {
    tytul: 'W Gdańsku',
    opis: 'Indywidualna lekcja Feldenkraisa prowadzona przez ruch, uwagę i delikatny dotyk. Pracujemy w ubraniu, zwykle na specjalnym stole, bez forsowania i narzucania jednej poprawnej formy.',
    dlaKogo: 'Dobry wybór, jeśli wolisz uczyć się przez dotyk i mieć przestrzeń przygotowaną do pracy.',
    miejsce: 'Gdańsk',
    cena: SESJE.cenaGdansk,
    track: 'cta-sesja-gdansk',
  },
  {
    tytul: 'Online',
    opis: 'Indywidualna lekcja ruchowa prowadzona słowami. Pracujemy wokół konkretnego pytania, a ruch wykonujesz we własnej przestrzeni i tempie.',
    dlaKogo: 'Dobry wybór, jeśli jesteś poza Trójmiastem albo chcesz pracować u siebie.',
    miejsce: 'online',
    cena: SESJE.cenaOnline,
    track: 'cta-sesja-online',
  },
];
---

<section id="sesje" class="sekcja-krecha" aria-label="Sesje indywidualne">
  <div class="wrap">
    <h2>Sesje indywidualne</h2>
    <p class="lead">
      Praca wokół pytania, które przynosisz: ruchu, który stał się trudny,
      przewlekłego wysiłku albo sposobu działania, który przestał pomagać.
      Zmiana zazwyczaj wymaga regularnej praktyki i przynajmniej kilku spotkań.
    </p>

    <figure class="foto">
      <Image
        src={fotoSesja}
        alt="Sesja Integracji Funkcjonalnej: osoba leży na stole, a Artur delikatnie prowadzi jej uniesione ramię"
        width={1200}
        widths={[480, 760, 1200]}
        sizes="(max-width: 44rem) 92vw, 40rem"
        loading="lazy"
      />
    </figure>

    <div class="formaty">
      {
        formaty.map((f) => (
          <article class="format">
            <h3>{f.tytul}</h3>
            <p class="opis">{f.opis}</p>
            <p class="dla">{f.dlaKogo}</p>
            <p class="meta">
              {f.miejsce} · {SESJE.czas}
              {f.cena && ` · ${f.cena}`}
              {' · '}
              <a href={sesjeHref} data-track={f.track}>umów sesję</a>
            </p>
          </article>
        ))
      }
    </div>

    <p class="nota">
      <a href={`mailto:${CONTACT.email}?subject=${encodeURIComponent('Sesja indywidualna')}`}>Napisz</a>,
      z czym przychodzisz. Odpowiadam zwykle w ciągu 1–2 dni roboczych.
      Więcej o tym, jak wygląda praca indywidualna:
      <a href="/indywidualnie/">Integracja Funkcjonalna</a>.
      Co mówią o niej klienci: <a href="/opinie/">opinie</a>.
    </p>
  </div>
</section>

<style>
  .foto {
    margin-top: 2rem;
  }

  .foto :global(img) {
    width: 100%;
    height: auto;
    filter: grayscale(1) contrast(1.04);
    border-radius: var(--radius);
  }

  .formaty {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
  }

  .format h3 {
    margin-bottom: 0.4rem;
  }

  .format .opis {
    color: var(--ink-soft);
    max-width: 62ch;
  }

  .format .dla {
    font-style: italic;
    color: var(--ink-soft);
    font-size: 0.95rem;
    margin-top: 0.4rem;
    max-width: 62ch;
  }

  .format .meta {
    font-size: 0.95rem;
    margin-top: 0.5rem;
  }

  .nota {
    margin-top: 2rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
    border-top: 1px solid var(--linia);
    padding-top: 1.2rem;
    max-width: 62ch;
  }
</style>
