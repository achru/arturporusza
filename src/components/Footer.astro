---
import { CONTACT, LEGAL } from '../config';

const year = new Date().getFullYear();
const legalLine = [LEGAL.company, LEGAL.nip && `NIP ${LEGAL.nip}`, LEGAL.address]
  .filter(Boolean)
  .join(' · ');
---

<footer>
  <div class="wrap">
    <!-- domknięcie strony: linia kończy się małą pętlą, jak podpis -->
    <svg class="podpis" viewBox="0 0 880 40" aria-hidden="true">
      <path
        vector-effect="non-scaling-stroke"
        d="M 0 28 L 796 28 C 818 28, 826 10, 812 8 C 800 6, 794 18, 806 24 C 816 29, 838 28, 880 28"
      ></path>
    </svg>

    <p class="linki">
      <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
      {' · '}
      <a href={CONTACT.instagram} target="_blank" rel="me noopener">Instagram</a>
      {CONTACT.youtube && (
        <>
          {' · '}
          <a href={CONTACT.youtube} target="_blank" rel="me noopener">YouTube</a>
        </>
      )}
      {' · '}
      <a href={CONTACT.platforma} target="_blank" rel="noopener">FeldenkraisOnline.pl</a>
    </p>
    <p class="linki">
      <a href="/o-mnie/">O mnie</a>
      {' · '}
      <a href="/polityka-prywatnosci/">Polityka prywatności</a>
      {LEGAL.regulaminUrl && (
        <>
          {' · '}
          <a href={LEGAL.regulaminUrl}>Zasady zapisów i rezygnacji</a>
        </>
      )}
    </p>
    <p class="drobiazg">
      © {year} {LEGAL.owner} · {CONTACT.city}{legalLine && ` · ${legalLine}`}
      <span class="motto">Od niejasności do klarowności.</span>
    </p>
  </div>
</footer>

<style>
  footer {
    padding-block: 1.5rem clamp(2.5rem, 6vw, 4rem);
  }

  .podpis {
    width: 100%;
    height: auto;
    display: block;
    margin-bottom: 1.8rem;
  }

  .podpis path {
    fill: none;
    stroke: var(--ink);
    stroke-width: var(--kreska);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .linki {
    font-size: 0.9rem;
    color: var(--ink-soft);
    margin-top: 0.35rem;
  }

  .drobiazg {
    margin-top: 1.4rem;
    font-size: 0.8rem;
    color: var(--ink-soft);
    display: flex;
    justify-content: space-between;
    gap: 1rem 2rem;
    flex-wrap: wrap;
  }

  .motto {
    font-style: italic;
  }
</style>
