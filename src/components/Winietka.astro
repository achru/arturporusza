---
// Winietki wydarzeń: ta sama linia, inny charakter dla każdego typu
// (cykl wychodzi ze spirali, warsztat zapętla się i żyje,
//  wyjazd płynie i rozgałęzia się nad wodą).
interface Props {
  typ: 'warsztat' | 'cykl' | 'wyjazd';
}
const { typ } = Astro.props;
---

{
  typ === 'cykl' && (
    <svg viewBox="0 0 220 100" aria-hidden="true">
      <path
        d="M 60 52 C 60 30, 92 26, 96 48 C 99 64, 76 68, 72 54 C 69 44, 84 40, 88 48 M 96 48 C 120 44, 160 46, 202 40"
        stroke="#1F5A5A"
        stroke-width="2.4"
      />
      <circle cx="202" cy="40" r="4" fill="#1F5A5A" />
    </svg>
  )
}
{
  typ === 'warsztat' && (
    <svg viewBox="0 0 220 100" aria-hidden="true">
      <path
        d="M 14 62 C 54 22, 96 20, 112 48 C 121 65, 98 74, 90 59 C 84 47, 102 40, 115 46 C 145 58, 172 52, 202 44"
        stroke="#A0522D"
        stroke-width="2.4"
      />
      <circle cx="202" cy="44" r="4" fill="#A0522D" />
    </svg>
  )
}
{
  typ === 'wyjazd' && (
    <svg viewBox="0 0 220 100" aria-hidden="true">
      <path
        d="M 14 54 C 44 46, 60 62, 90 54 C 115 48, 126 54, 140 52 M 140 52 C 160 44, 176 36, 198 30 M 140 52 C 160 60, 176 66, 198 72"
        stroke="#5F7052"
        stroke-width="2.4"
      />
      <circle cx="198" cy="30" r="4" fill="#5F7052" />
      <circle cx="198" cy="72" r="4" fill="#5F7052" />
    </svg>
  )
}

<style>
  svg {
    width: min(230px, 60%);
    height: auto;
    display: block;
  }

  svg :global(path) {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
