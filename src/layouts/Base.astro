---
import '@fontsource-variable/literata/opsz.css';
import '@fontsource-variable/literata/opsz-italic.css';
import '../styles/global.css';
import { SITE, CONTACT, LEGAL } from '../config';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  ogImage = '/og.jpg',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImageAbs = new URL(ogImage, SITE.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${SITE.url}/#artur`,
      name: 'Artur Chruszcz',
      alternateName: 'Artur Porusza',
      jobTitle: 'Nauczyciel metody Feldenkraisa',
      description: SITE.description,
      url: SITE.url,
      email: CONTACT.email,
      address: { '@type': 'PostalAddress', addressLocality: CONTACT.city, addressCountry: 'PL' },
      areaServed: ['Gdańsk', 'Trójmiasto', 'online'],
      knowsAbout: ['metoda Feldenkraisa', 'świadomość przez ruch', 'uczenie motoryczne', 'edukacja ruchowa'],
      sameAs: [CONTACT.instagram, CONTACT.youtube, CONTACT.platforma].filter(Boolean),
    },
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#org`,
      name: LEGAL.company || 'Artur Porusza',
      url: SITE.url,
      email: CONTACT.email,
      founder: { '@id': `${SITE.url}/#artur` },
      address: { '@type': 'PostalAddress', addressLocality: CONTACT.city, addressCountry: 'PL' },
    },
  ],
};

const kontrakt = `impeccable-direction c03bb407/9ebfa753
THESIS: A quiet informational home drawn with one ink line; refuses the practitioner-site default (pastel hero, CTA buttons, card grids, urgency chips) — reading and finding replace persuading.
OWN-WORLD: Paper white #fbfaf7, warm near-black ink, sanguine red-chalk accent on links and live markers only; one family (Literata, optical axis) at every size; hairline paper rules; one continuous ink line that becomes a reclining figure; grayscale photography.
STORY: A visitor reads who Artur is and what the practice is, finds terminy and sesje within seconds, and follows quiet links to sign up — nothing pushes.
FIRST VIEWPORT: Slim static header (name + text links); one prose statement as h1 with a short lead; the ruled line rises into the one-line figure and returns to a rule; three wayfinding links; terminy directly below.
FORM: Single-line contour-figure world — user-steered rendition of the dealt plane-portrait figure (steer: "Figura but more minimalistic"); staging: one narrow reading column; seeds c03bb407, 9ebfa753.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md`;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Fragment set:html={`<!--\n${kontrakt}\n-->`} />
    <a class="skip" href="#tresc">Przejdź do treści</a>
    <slot />
  </body>
</html>
