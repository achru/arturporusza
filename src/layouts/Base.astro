---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '../styles/global.css';
import { SITE, CONTACT, LEGAL } from '../config';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  ogImage = '/og.jpg',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImageAbs = new URL(ogImage, SITE.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${SITE.url}/#artur`,
      name: 'Artur Chruszcz',
      alternateName: 'Artur Porusza',
      jobTitle: 'Nauczyciel metody Feldenkraisa',
      description: SITE.description,
      url: SITE.url,
      email: CONTACT.email,
      address: { '@type': 'PostalAddress', addressLocality: CONTACT.city, addressCountry: 'PL' },
      areaServed: ['Gdańsk', 'Trójmiasto', 'online'],
      knowsAbout: ['metoda Feldenkraisa', 'świadomość przez ruch', 'uczenie motoryczne', 'edukacja ruchowa'],
      sameAs: [CONTACT.instagram, CONTACT.youtube, CONTACT.platforma].filter(Boolean),
    },
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#org`,
      name: LEGAL.company || 'Artur Porusza',
      url: SITE.url,
      email: CONTACT.email,
      founder: { '@id': `${SITE.url}/#artur` },
      address: { '@type': 'PostalAddress', addressLocality: CONTACT.city, addressCountry: 'PL' },
    },
  ],
};
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // Znacznik działającego JS — dopiero wtedy CSS ukrywa sekcje do animacji.
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip" href="#tresc">Przejdź do treści</a>
    <slot />

    <script>
      // Hero: wejście elementów z lekkim opóźnieniem kaskadowym.
      document.querySelectorAll<HTMLElement>('[data-anim]').forEach((el, i) => {
        el.setAttribute('data-reveal', '');
        el.style.setProperty('--reveal-delay', `${100 + i * 90}ms`);
        requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('in')));
      });

      // Pozostałe sekcje: wejście przy przewinięciu.
      const revealed = document.querySelectorAll('[data-reveal]:not([data-anim])');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.12 }
        );
        revealed.forEach((el) => io.observe(el));
      } else {
        revealed.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>
